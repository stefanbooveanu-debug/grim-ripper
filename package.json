{
  "name": "grim_drip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd backend && .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --reload",
    "setup:api": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "dev:frontend-stefan": "npm run dev --prefix frontend-stefan -- --host 127.0.0.1 --port 5173",
    "dev:all": "concurrently -k -n api,vite,next -c blue,green,magenta \"npm run dev:api\" \"npm run dev:frontend-stefan\" \"npm run dev -- --port 3000\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm install --prefix frontend-stefan"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4"
  }
}
